# ----------------------------------------------------------------------
# 1. URL Rewriting & Clean URLs
# ----------------------------------------------------------------------
RewriteEngine On

# ڕێگەدان بە دەستگەیشتن بە فۆڵدەرەکانی ئەسێت و ڤێندۆر
RewriteRule ^assets/ - [L]
RewriteRule ^vendor/ - [L]

# ڕێگەدان بە پرۆسێسە ناوخۆییەکانی وێب ئەپەکە
RewriteCond %{REQUEST_URI} ^/(process|includes|core|config|database)/.*\.php$ [NC]
RewriteRule ^ - [L]

# لابردنی پاشگری .php لە بەستەرەکان (Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# ناوخۆیی نیشاندانی فایلەکان بەبێ پاشگری .php (Rewrite)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ڕێکخستنی لاپەڕەکانی ناو فۆڵدەری pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pages/([^\.]+)$ pages/$1.php [NC,L]

# ڕێڕەوکردنی لاپەڕە سەرەکییەکانی داشبۆرد و یوزەر بۆ ناو فۆڵدەری pages
RewriteRule ^(dashboard|users|reports|profile)$ pages/$1.php [L]

# ----------------------------------------------------------------------
# 2. Security & Directory Protection
# ----------------------------------------------------------------------
# قەدەغەکردنی بینینی لیستەی فۆڵدەرەکان
Options -Indexes

# بلۆککردنی فایلی .env و فۆڵدەری .git و هەموو فایلە شاراوەکان (.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# دڵنیابوونەوە لە بلۆککردنی فۆڵدەری .git بە تایبەتی
RewriteRule ^\.git - [F,L]

# پاراستنی فایلە هەستیارەکانی وەک لۆگ و کۆنفێگ
<FilesMatch "\.(json|log|yml|yaml|config|ini|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# 3. Security Headers (CSP, HSTS, Referrer, etc.)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Content Security Policy - چارەسەری XSS و unsafe-inline
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'self';"

    # Strict Transport Security (HSTS) - بۆ ماوەی ٦ مانگ
    Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"

    # Referrer Policy - چارەسەری کێشەی دزەکردنی سەرچاوەی بەستەر
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # پاراستن لە Clickjacking و Sniffing
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ----------------------------------------------------------------------
# 4. PHP Settings (Upload Limits)
# ----------------------------------------------------------------------
<IfModule mod_php7.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 100M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 100M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>